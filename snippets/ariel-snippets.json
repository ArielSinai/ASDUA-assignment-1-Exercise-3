{
  "Ariel function": {
    "prefix": "func",
    "body": [
      "func ${1:name} {",
      "    ${0}",
      "}"
    ],
    "description": "Function skeleton in ArielLang"
  },
  "Ariel if/else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    ${2:// body}",
      "} else {",
      "    ${0:// else body}",
      "}"
    ],
    "description": "if/else statement in ArielLang"
  },
  "Ariel print": {
    "prefix": "print",
    "body": [
      "print \"${1:message}\""
    ],
    "description": "print a string in ArielLang"
  }
}
